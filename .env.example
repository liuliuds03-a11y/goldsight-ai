# ============================================================
# GoldSight AI V3.0 - 环境变量配置
# 复制本文件为 .env 并填入实际配置
# ============================================================

# PostgreSQL 数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goldsight
POSTGRES_USER=goldsight
POSTGRES_PASSWORD=your_password_here

DATABASE_URL=postgresql://goldsight:your_password_here@localhost:5432/goldsight

# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_URL=redis://:your_redis_password_here@localhost:6379/0

# DeepSeek AI API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8016
BACKEND_LOG_LEVEL=info

# JWT 认证
JWT_SECRET_KEY=generate_a_secure_random_string_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 前端
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1

# 应用
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
