# ============================================================
# GoldSight AI V3.0 - 环境变量模板
# 使用说明：
# 1. 复制本文件为 .env
# 2. 根据实际环境修改配置值
# 3. 严禁将 .env 文件提交到 Git 仓库
# ============================================================

# ------------------------------------------------------------
# PostgreSQL 数据库配置
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goldsight
POSTGRES_USER=goldsight
POSTGRES_PASSWORD=goldsight_dev_2024

# 数据库连接 URL（部分框架使用）
DATABASE_URL=postgresql://goldsight:goldsight_dev_2024@localhost:5432/goldsight

# ------------------------------------------------------------
# Redis 缓存配置
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=goldsight_redis_dev_2024
REDIS_DB=0

# Redis 连接 URL
REDIS_URL=redis://:goldsight_redis_dev_2024@localhost:6379/0

# ------------------------------------------------------------
# DeepSeek API 配置
# 注意：请填写您的真实 API Key，严禁提交到版本控制
# ------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# 后端服务配置
# ------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# JWT 密钥（开发环境使用，生产环境请更换）
JWT_SECRET_KEY=please_change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------
# 前端服务配置
# ------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------
# 应用环境
# ------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
